<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
      <PackageReference Include="NUnit" Version="5.0.0" />
      <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
      <PackageReference Include="Selenium.Support" Version="4.52.0" />
      <PackageReference Include="Selenium.WebDriver" Version="4.52.0" />
      <PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="158.0.8127.200-beta" />
    </ItemGroup>

    <ItemGroup>
      <None Update="test_file.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
